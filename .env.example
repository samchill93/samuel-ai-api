# Copy this file to a new file named exactly ".env" and paste your real key below.
# Get a key at https://console.anthropic.com  (the same place as your Cadence project).
# The .env file is git-ignored, so your key never gets committed to GitHub.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Comma-separated list of browser origins allowed to call this API (CORS).
# If unset, the code defaults to the production site only. For local development, list the
# localhost origins you serve the site from, e.g.:
# CORS_ORIGINS=https://living-portfolio-chi.vercel.app,http://localhost:8080,http://127.0.0.1:8080

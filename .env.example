# Copy this file to a new file named exactly ".env" and paste your real values below.
# The .env file is git-ignored, so nothing here ever gets committed to GitHub.

# --- Required ---------------------------------------------------------------

# The chat model. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Embeddings for RAG (retrieval). Get a key at https://platform.openai.com
# (a separate account from Anthropic; the API needs a small prepaid balance).
OPENAI_API_KEY=sk-your-openai-key-here

# The vector store: a Postgres connection string with the pgvector extension.
# A Neon free-tier database works well. Used by apply_schema.py, ingest.py, and retrieval.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Optional ---------------------------------------------------------------

# Comma-separated browser origins allowed to call this API (CORS).
# If unset, the code defaults to the production site only. For local development:
# CORS_ORIGINS=https://living-portfolio-chi.vercel.app,http://localhost:8080,http://127.0.0.1:8080

# Override the embedding provider/model if needed (defaults shown).
# EMBED_PROVIDER=openai
# EMBED_MODEL=text-embedding-3-small

# Rate limiting for the paid LLM endpoints (/chat, /chat/stream, /agent), per client IP.
# Defaults: 20 requests per 60-second window. Tune without a code change.
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW=60

# Also serve the MCP server over streamable HTTP at /mcp on this API (off by default).
# Note: /mcp is NOT covered by the rate limiter above — throttle it before exposing it widely.
# ENABLE_MCP_HTTP=1

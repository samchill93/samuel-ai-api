# Keep the image small and — most importantly — keep secrets out of it.
# The corpus/*.md files are NOT excluded: the app reads them at runtime.

.env
.env.*
!.env.example

# Local virtualenv and Python caches
venv/
.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/

# Version control and Docker meta
.git/
.gitignore
.dockerignore
Dockerfile
docker-compose.yml

# Large, gitignored eval run outputs (regenerated by the harness)
evals/results.json
evals/judged.json

# Editor / OS noise
.vscode/
.idea/
.DS_Store
